<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="current_assignment"
            type="com.example.reater.models.Assignment" />
    </data>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/assignment_row_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="6dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:cardBackgroundColor="@color/academic_card"
        app:cardCornerRadius="16dp"
        app:cardElevation="1dp"
        app:strokeColor="@color/academic_stroke"
        app:strokeWidth="1dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- Hidden view4 kept for backwards ID compatibility if referenced programmatically -->
            <View
                android:id="@+id/view4"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Icon Badge -->
            <FrameLayout
                android:id="@+id/assignment_badge_container"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/circle_white_bg"
                android:backgroundTint="@color/badge_amber_bg"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/imageView24"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    app:tint="@color/badge_amber_tint"
                    android:src="@drawable/ic_baseline_insert_drive_file_24" />
            </FrameLayout>

            <!-- Assignment Name -->
            <TextView
                android:id="@+id/Assignment_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="8dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="2"
                android:text="@{current_assignment.assignmentName}"
                android:textColor="@color/academic_text_primary"
                android:textSize="15sp"
                app:layout_constraintEnd_toStartOf="@+id/subject_badge_card"
                app:layout_constraintStart_toEndOf="@+id/assignment_badge_container"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Operating Systems Lab 3: Deadlock Prevention" />

            <!-- Subject Badge Pill -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/subject_badge_card"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                app:cardBackgroundColor="@color/academic_stroke_light"
                app:cardCornerRadius="6dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="6dp">

                    <TextView
                        android:id="@+id/assignment_subjectcode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="SUB: "
                        android:textColor="@color/academic_text_muted"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/subject_id_assigment"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@{current_assignment.subjectid}"
                        android:textColor="@color/academic_text_secondary"
                        android:textSize="10sp"
                        tools:text="CS-302" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Due Date Container -->
            <LinearLayout
                android:id="@+id/due_date_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/assignment_badge_container"
                app:layout_constraintTop_toBottomOf="@+id/Assignment_name">

                <TextView
                    android:id="@+id/textView2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:text="Due: "
                    android:textColor="@color/academic_text_muted"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/due_date_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@{current_assignment.dueDate}"
                    android:textColor="@color/badge_rose_tint"
                    android:textSize="12sp"
                    tools:text="Nov 15, 2026 • 11:59 PM" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</layout>