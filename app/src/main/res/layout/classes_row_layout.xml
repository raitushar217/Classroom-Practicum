<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <data>
        <variable
            name="individual_course"
            type="com.example.reater.models.Coursework" />
    </data>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="7dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="@color/academic_card"
        app:cardCornerRadius="20dp"
        app:cardElevation="2dp"
        app:strokeColor="@color/academic_stroke"
        app:strokeWidth="1dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            onCourseworkClickListener="@{individual_course}"
            android:padding="16dp">

            <!-- Course Icon Badge -->
            <FrameLayout
                android:id="@+id/subject_icon_container"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/circle_white_bg"
                android:backgroundTint="@color/academic_indigo_bg"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/subject_image_id"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    app:tint="@color/academic_indigo"
                    app:srcCompat="@drawable/ic_baseline_insert_drive_file_24" />
            </FrameLayout>

            <!-- Subject Name -->
            <TextView
                android:id="@+id/Subject_Name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="10dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="@{individual_course.subjectName}"
                android:textColor="@color/academic_text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@+id/ivChevronContainer"
                app:layout_constraintStart_toEndOf="@+id/subject_icon_container"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Advanced Algorithms" />

            <!-- Metadata Row: Code & Faculty -->
            <LinearLayout
                android:id="@+id/metaContainer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/ivChevronContainer"
                app:layout_constraintStart_toEndOf="@+id/subject_icon_container"
                app:layout_constraintTop_toBottomOf="@+id/Subject_Name">

                <!-- Subject ID Badge -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    app:cardBackgroundColor="@color/academic_stroke_light"
                    app:cardCornerRadius="6dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <TextView
                        android:id="@+id/textView16"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:paddingHorizontal="6dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@{individual_course.subjectID}"
                        android:textColor="@color/academic_text_secondary"
                        android:textSize="11sp"
                        tools:text="CS-302" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="6dp"
                    android:text="•"
                    android:textColor="@color/academic_text_muted"
                    android:textSize="12sp" />

                <!-- Teacher Name -->
                <TextView
                    android:id="@+id/textView18"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif"
                    android:maxLines="1"
                    android:text="@{individual_course.teacherName}"
                    android:textColor="@color/academic_text_secondary"
                    android:textSize="12sp"
                    tools:text="Dr. John Doe" />
            </LinearLayout>

            <!-- Trailing Action Chevron -->
            <FrameLayout
                android:id="@+id/ivChevronContainer"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/circle_white_bg"
                android:backgroundTint="@color/academic_stroke_light"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/ivChevron"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:rotation="180"
                    android:src="@drawable/baseline_arrow_back_24"
                    app:tint="@color/academic_indigo" />
            </FrameLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</layout>