<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Reater" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand colors -->
        <item name="colorPrimary">@color/iiitu_navy</item>
        <item name="colorOnPrimary">@color/iiitu_white</item>
        <item name="colorPrimaryContainer">@color/iiitu_navy_light</item>
        <item name="colorOnPrimaryContainer">@color/iiitu_white</item>
        <item name="colorSecondary">@color/iiitu_accent</item>
        <item name="colorOnSecondary">@color/iiitu_white</item>
        <item name="colorSecondaryContainer">@color/iiitu_navy_dark</item>
        <item name="colorOnSecondaryContainer">@color/iiitu_white</item>
        <item name="colorTertiary">@color/iiitu_gold</item>
        <item name="colorOnTertiary">@color/iiitu_navy_dark</item>
        <item name="colorTertiaryContainer">@color/iiitu_gold_light</item>
        <item name="colorOnTertiaryContainer">@color/iiitu_navy</item>
        <item name="colorError">@color/colorError</item>
        <item name="colorOnError">@color/colorOnError</item>
        <item name="colorSurface">@color/iiitu_white</item>
        <item name="colorOnSurface">@color/premium_text_primary</item>
        <item name="colorSurfaceVariant">@color/iiitu_light_bg</item>
        <item name="colorOnSurfaceVariant">@color/premium_text_secondary</item>

        <!-- App surfaces -->
        <item name="android:colorBackground">@color/iiitu_light_bg</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/iiitu_navy</item>

        <!-- Default typography -->
        <item name="android:fontFamily">sans-serif</item>
    </style>


    <style name="CustomTabLayoutStyle"
        parent="Widget.Design.TabLayout">

        <item name="background">@color/GunmetalGray</item>
        <item name="tabIndicatorColor">@color/Cream</item>
        <item name="tabIndicatorHeight">1dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="tabSelectedTextColor">@color/Cream</item>
    </style>
    <style name="CustomTabTextStyle" parent="TextAppearance.Design.Tab">
    <item name="android:textColor">@color/white</item>
    </style>

    <!-- Bottom Navigation Styles -->
    <style name="BottomNavActiveIndicator" parent="">
        <item name="android:color">@color/iiitu_navy_light</item>
        <item name="shapeAppearanceOverlay">@style/BottomNavIndicatorShape</item>
    </style>

    <style name="BottomNavIndicatorShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="BottomNavTextActive" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="fontFamily">sans-serif-medium</item>
    </style>

    <style name="BottomNavTextInactive" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">11sp</item>
        <item name="fontFamily">sans-serif</item>
    </style>
</resources>